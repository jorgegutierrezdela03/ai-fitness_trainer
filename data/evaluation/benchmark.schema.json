{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FitEvidence benchmark case",
  "type": "object",
  "required": ["case_id", "split", "profile", "request", "expected", "tags"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^FE-[0-9]{4}$"},
    "split": {"enum": ["development", "test"]},
    "profile": {
      "type": "object",
      "required": ["age_years", "experience_level", "goal", "session_duration_minutes", "equipment", "restrictions"],
      "properties": {
        "age_years": {"type": "integer", "minimum": 18, "maximum": 100},
        "experience_level": {"enum": ["beginner", "intermediate", "advanced"]},
        "goal": {"enum": ["hypertrophy", "strength", "general_fitness"]},
        "training_days_per_week": {"type": ["integer", "null"], "minimum": 1, "maximum": 7},
        "session_duration_minutes": {"type": "integer", "minimum": 10, "maximum": 180},
        "equipment": {"type": "array", "items": {"type": "string"}},
        "restrictions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "request": {"type": "string", "minLength": 3},
    "expected": {
      "type": "object",
      "properties": {
        "target_muscles": {"type": "array", "items": {"type": "string"}},
        "max_duration_minutes": {"type": "integer", "minimum": 10, "maximum": 180},
        "must_respect_experience_level": {"type": "boolean"},
        "clarification_expected": {"type": "boolean"},
        "safety_route_expected": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "tags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
